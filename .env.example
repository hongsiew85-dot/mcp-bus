# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LTA_ACCOUNT_KEY: Land Transport Authority (LTA) Datamall v3 API Key.
# Obtain your free API key at: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
# Add this variable to your Vercel Project Settings > Environment Variables.
LTA_ACCOUNT_KEY="YOUR_LTA_DATAMALL_ACCOUNT_KEY"
